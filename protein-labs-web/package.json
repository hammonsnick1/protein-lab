{
  "name": "protein-labs",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Offline protein planning, analysis, purification, and research workspace.",
  "homepage": "https://proteinlabs.local",
  "author": {
    "name": "Protein Lab",
    "email": "protein-labs@localhost.invalid"
  },
  "desktopName": "protein-labs.desktop",
  "private": true,
  "main": "desktop/electron/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"lib/*.test.ts\"",
    "desktop:build:web": "vite build --config desktop/vite.config.ts",
    "build": "npm run desktop:build:web",
    "desktop:run": "npm run desktop:build:web && electron .",
    "desktop:package": "npm run desktop:build:web && electron-builder --linux AppImage"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "molstar": "^5.13.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^6.1.0",
    "globals": "^16.0.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "8.0.13"
  },
  "type": "module",
  "build": {
    "appId": "org.proteinlabs.desktop",
    "productName": "Protein Lab",
    "artifactName": "Protein-Labs-${version}-${arch}.${ext}",
    "asar": true,
    "icon": "desktop/assets/icon.png",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/electron/**/*",
      "desktop/assets/**/*",
      "desktop-dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../protein-labs/backend/dist",
        "to": "backend",
        "filter": [
          "protein-labs-backend",
          "protein-labs-backend.exe"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "category": "Science;Biology",
      "icon": "desktop/assets/icons",
      "executableName": "protein-labs",
      "maintainer": "Protein Lab <protein-labs@localhost.invalid>",
      "synopsis": "Offline protein science workspace",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Protein Lab",
          "GenericName": "Protein Science Workspace",
          "StartupWMClass": "protein-labs"
        }
      }
    },
    "deb": {
      "packageCategory": "science"
    },
    "pacman": {
      "artifactName": "protein-labs-${version}-1-x86_64.pkg.tar.zst",
      "compression": "zstd",
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "at-spi2-core",
        "libcups",
        "libdrm",
        "mesa",
        "libxkbcommon",
        "libxcomposite",
        "libxdamage",
        "libxrandr",
        "xdg-utils"
      ]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Protein Lab ${version}"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Protein Lab",
      "uninstallDisplayName": "Protein Lab"
    }
  },
  "//": "Run `npm install-scripts approve electron` after npm ci, or `npx electron --version` once to fetch the runtime."
}
